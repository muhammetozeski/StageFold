@page "/cuts"
@inherits ActionPage
@inject StageApi Api
@inject AccountSession Session
<PageTitle>Public cuts — StageFold</PageTitle>
<div class="page"><h1>Watch and remix</h1><p>Play a film or give its story a different ending.</p><Status Text="@Message" Error="@IsError" />
<div class="search-bar"><label>Find a title or synopsis<input disabled="@Busy" maxlength="100" @bind="Search" /></label><label class="check"><input type="checkbox" disabled="@(Busy||Session.Current is null)" @bind="Mine" />My published and withdrawn cuts</label><button disabled="@Busy" @onclick="SearchNow">Search</button></div>
@if(Items.Length==0&&!Busy){<p class="empty">No films found. Try a starter below.</p>}
<ul class="cut-list">@foreach(var c in Items){<li><h2><a href="@("cut/"+c.Id)">@c.Title</a></h2><p>@c.Summary</p><p class="hint">By @c.AuthorAlias · @c.License · @(c.ParentCut is null?"Original publication":"Attributed remix") @if(c.Withdrawn){<b>· Withdrawn</b>} @if(c.Hidden){<b>· Hidden by operator</b>}</p><a href="@("cut/"+c.Id)">Play this cut →</a></li>}</ul>
<div class="actions"><button class="secondary" disabled="@(Busy||Offset==0)" @onclick="Previous">Previous</button><span>Page @(Offset/20+1)</span><button class="secondary" disabled="@(Busy||!HasMore)" @onclick="Next">Next</button></div>
<section><h2>Starter films</h2><p>Choose a 28-second story to edit.</p><ol class="starter-library">@for(var i=0;i<Examples.Length;i++){var n=i;var film=Examples[i];<li><h3>@film.Title</h3><p>@film.Shots[0].Speech[0].Text</p><span class="hint">@film.Shots.Count shots · @film.Shots[0].Stage</span><a href="@("studio?starter="+n)">Edit this film →</a></li>}</ol></section></div>
@code {string Search="";bool Mine,HasMore;int Offset;CutInfo[] Items=[];Film[] Examples=Starters.All();protected override async Task OnInitializedAsync(){await Act("read public cuts",async()=>{await Session.Load();await Load();});}async Task Load(){var generation=Session.Generation;var result=await Api.Get<CutsReply>("cuts?search="+Uri.EscapeDataString(Search)+"&offset="+Offset+(Mine?"&mine=true":""));if(generation!=Session.Generation)return;Items=result.Cuts;HasMore=result.HasMore;}Task SearchNow()=>Act("search cuts",async()=>{Offset=0;await Load();});Task Next()=>Act("next cuts",async()=>{Offset+=20;await Load();});Task Previous()=>Act("previous cuts",async()=>{Offset=Math.Max(0,Offset-20);await Load();});}
