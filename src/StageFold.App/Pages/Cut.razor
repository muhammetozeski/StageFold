@page "/cut/{Id}"
@inherits ActionPage
@implements IAsyncDisposable
@inject StageApi Api
@inject AccountSession Session
@inject IJSRuntime JS
@inject NavigationManager Navigation
<PageTitle>@(CutData?.Title??"Public cut") — StageFold</PageTitle>
<div class="page"><h1>@(CutData?.Title??"Opening the film…")</h1><Status Text="@Message" Error="@IsError" />
@if(CutData is {Film:{} film} cut){<p>@cut.Summary</p><p>Published by @cut.AuthorAlias · @DateTimeOffset.FromUnixTimeMilliseconds(cut.CreatedAt).ToString("u") · <a href="https://creativecommons.org/licenses/by/4.0/" rel="noreferrer" target="_blank">@cut.License</a>@if(cut.Withdrawn){<b> · Withdrawn from public serving</b>}@if(cut.Hidden){<b> · Hidden by operator</b>}</p><canvas id="@CanvasId" aria-label="Published captioned motion comic"></canvas><div class="transport"><button disabled="@Busy" @onclick="Play">▶ Play film</button><button class="secondary" disabled="@Busy" @onclick="Pause">Pause</button><label>Film time<input type="range" disabled="@Busy" min="0" max="@FilmRules.Duration(film)" value="@TimeMs" step="50" @oninput="Seek" /></label><span>@((TimeMs/1000.0).ToString("0.0"))s</span></div><div class="actions"><button disabled="@Busy" @onclick="Html">Download playable film</button><button class="secondary" disabled="@Busy" @onclick="Json">Save editable file</button>@if(Session.Current is not null&&!cut.Withdrawn&&!cut.Hidden){<button disabled="@Busy" @onclick="Fork">Remix this film</button>}else if(Session.Current is null){<a href="@("account?cut="+Id)">Sign in to remix</a>}</div><details><summary>Downloads and credit</summary><p class="hint">No audio. Scene JSON contains the film data only; preserve the displayed credit when using it elsewhere. The playable film includes the credit.</p><p class="hint">Film fingerprint: <code>@cut.BodyHash</code></p></details>
@if(cut.Parent is {} parent){<section><h2>Changes from the source</h2><p>Based on <a href="@("cut/"+parent.Id)">@parent.Title</a> by @parent.AuthorAlias under @parent.License. </p>@if(cut.Changes is {} changes){<ul>@if(changes.CastChanged){<li>Cast changed</li>}@foreach(var title in changes.ChangedShots){<li>Changed performance or dialogue: @title</li>}@foreach(var title in changes.AddedShots){<li>Added shot: @title</li>}@foreach(var title in changes.RemovedShots){<li>Removed shot: @title</li>}<li>Duration: @(changes.DurationBefore/1000.0)s → @(changes.DurationAfter/1000.0)s</li></ul>}
@if(parent.Available){<button class="secondary" disabled="@Busy" @onclick="Compare">Compare films</button>}else{<p>The source is withdrawn or hidden. Its pinned attribution remains; this licensed descendant is a separate publication.</p>}
@if(SourceFilm is not null){<label>Compare at film time<input type="range" disabled="@Busy" min="0" max="@Math.Max(FilmRules.Duration(SourceFilm),FilmRules.Duration(film))" value="@CompareMs" step="100" @oninput="CompareSeek" /></label><div class="two"><div><h3>Pinned source</h3><canvas id="@("source-"+Id)"></canvas></div><div><h3>This cut</h3><canvas id="@("descendant-"+Id)"></canvas></div></div>}</section>}
<section><details><summary>Report this cut</summary><p>Reports go privately to the site operator.</p><label>Reason<select disabled="@Busy" @bind="ReportReason"><option value="spam">Spam</option><option value="unsafe">Unsafe content</option><option value="rights">Rights or attribution</option><option value="privacy">Personal information</option></select></label><label>What should the operator review?<textarea disabled="@Busy" maxlength="1000" @bind="ReportNote"></textarea></label><button class="secondary" disabled="@Busy" @onclick="Report">Submit report</button></details></section>
@if(cut.Owned){<section><details><summary>Withdraw my public cut</summary><p>This stops new public serving and new forks. Exported copies and existing licensed descendants remain. The immutable body is retained for provenance and operator review.</p><label class="check"><input type="checkbox" disabled="@Busy" @bind="WithdrawConfirmed" />Withdraw this cut from public serving.</label><button class="danger" disabled="@(Busy||!WithdrawConfirmed)" @onclick="Withdraw">Withdraw public cut</button></details></section>}}
else if(!Busy){<p>The cut may be unavailable or withdrawn. <a href="cuts">Open the public cutting room</a>.</p>}</div>
@code {
 [Parameter]public string Id{get;set;}="";CutInfo? CutData;Film? SourceFilm;IJSObjectReference? Module;DotNetObjectReference<Cut>? Reference;string? MountedId;long Epoch;bool PendingMount,PendingComparison,WithdrawConfirmed;int TimeMs,CompareMs=1000;string ForkRequest=Guid.NewGuid().ToString(),ReportReason="spam",ReportNote="";string CanvasId=>"cut-"+Id;
 protected override async Task OnParametersSetAsync(){var epoch=++Epoch;var selected=Id;CutData=null;SourceFilm=null;WithdrawConfirmed=false;TimeMs=0;ForkRequest=Guid.NewGuid().ToString();await Act("open public film",async()=>{await Session.Load();var generation=Session.Generation;var response=await Api.Get<CutReply>("cuts/"+Uri.EscapeDataString(selected));if(epoch!=Epoch||selected!=Id||generation!=Session.Generation)return;if(response.Cut.Film is null)throw new FormatException("The cut contains no film.");FilmRules.Validate(response.Cut.Film);CutData=response.Cut;PendingMount=true;},replace:true);}
 protected override async Task OnAfterRenderAsync(bool first){if(PendingMount){PendingMount=false;await Act("open cut stage",async()=>{Module??=await JS.InvokeAsync<IJSObjectReference>("import","./stage.js");Reference??=DotNetObjectReference.Create(this);await Module.InvokeVoidAsync("mount",CanvasId,Reference,CutData!.Film);MountedId=CanvasId;});StateHasChanged();}if(PendingComparison){PendingComparison=false;await DrawComparison();}}
 string Credit()=>CutData is {} c?$"{c.Title} by {c.AuthorAlias}. StageFold cut {Navigation.BaseUri}cut/{c.Id}. {c.License} (https://creativecommons.org/licenses/by/4.0/). "+(c.Parent is {} p?$"Adapted from {p.Title} by {p.AuthorAlias}, {Navigation.BaseUri}cut/{p.Id}, {p.License}; changes made. ":"")+"No audio.":"";
 Task Play()=>Act("play public film",async()=>await Module!.InvokeVoidAsync("play"));Task Pause()=>Act("pause public film",async()=>await Module!.InvokeVoidAsync("pause"));
 async Task Seek(ChangeEventArgs e){if(Busy||!int.TryParse(e.Value?.ToString(),out var ms))return;TimeMs=ms;await Module!.InvokeVoidAsync("seek",ms);}
 Task Html()=>Act("export licensed film",async()=>{await Module!.InvokeAsync<int>("downloadHtml",CutData!.Film,Credit());Message="Playable film downloaded with credit.";});
 Task Json()=>Act("export scene data",async()=>{await Module!.InvokeAsync<int>("downloadJson",FilmRules.Serialize(CutData!.Film!));Message="Scene JSON downloaded. Keep the source credit displayed on this page when reusing it.";});
 Task Fork()=>Act("fork cut",async()=>{var selected=Id;var generation=Session.Generation;var result=await Api.Post<ProjectReply>("cuts/"+selected+"/fork",new{requestId=ForkRequest});if(selected!=Id||generation!=Session.Generation)return;Navigation.NavigateTo("studio?project="+result.Project.Id);});
 Task Compare()=>Act("compare immutable cuts",async()=>{var selected=Id;var result=await Api.Get<CutReply>("cuts/"+CutData!.Parent!.Id);if(selected!=Id)return;SourceFilm=result.Cut.Film;PendingComparison=true;});
 async Task CompareSeek(ChangeEventArgs e){if(Busy||!int.TryParse(e.Value?.ToString(),out var ms))return;CompareMs=ms;await DrawComparison();}
 async Task DrawComparison(){if(Module is null||SourceFilm is null||CutData?.Film is null)return;await Module.InvokeVoidAsync("preview","source-"+Id,SourceFilm,CompareMs);await Module.InvokeVoidAsync("preview","descendant-"+Id,CutData.Film,CompareMs);}
 Task Report()=>Act("report cut",async()=>{var selected=Id;await Api.Post<OkReply>("cuts/"+selected+"/report",new{reason=ReportReason,note=ReportNote});if(selected!=Id)return;ReportNote="";Message="Report sent.";});
 Task Withdraw()=>Act("withdraw cut",async()=>{var selected=Id;await Api.Post<OkReply>("cuts/"+selected+"/withdraw",new{});if(selected!=Id)return;CutData!.Withdrawn=true;WithdrawConfirmed=false;Message="The cut is withdrawn. Existing exported copies and licensed remixes remain.";});
 [JSInvokable]public Task OnPlayback(int ms,bool playing){TimeMs=ms;StateHasChanged();return Task.CompletedTask;}
 public async ValueTask DisposeAsync(){Reference?.Dispose();if(Module is not null){try{await Module.InvokeVoidAsync("dispose",MountedId);await Module.DisposeAsync();}catch(JSDisconnectedException){}}}
}
