@page "/"
@page "/studio"
@inherits ActionPage
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StageApi Api
@inject AccountSession Session
@inject NavigationManager Navigation
<PageTitle>@Film.Title — StageFold studio</PageTitle>
<section class="studio-heading"><div><h1>Make a short film</h1><p>Move the cast, write their lines and play your story.</p></div><div class="starter-select"><label>Start with a story <select disabled="@Busy" @onchange="LoadStarter"><option value="">Choose a complete film</option>@for(var i = 0; i < Examples.Length; i++){<option value="@i">@Examples[i].Title</option>}</select></label></div></section>
<Status Text="@Message" Error="@IsError" />@if(PendingReplacement is not null){<section class="replace-prompt" role="alert"><h2>@ReplacementLabel?</h2><p>This replaces the film currently open in the editor. Download an editable file first if you want to keep it.</p><button class="danger" disabled="@Busy" @onclick="ConfirmReplacement">Replace open film</button><button class="secondary" disabled="@Busy" @onclick="CancelReplacement">Keep editing</button></section>}
<section class="shared-bar">@if(SharedProject is {} shared){<span class="pill">@shared.Role</span><strong>@shared.Title</strong><span>Editing from revision @SharedRevision @if(HistoricalRevision is not null){<b>· historical revision @HistoricalRevision loaded as an unsaved copy</b>}</span><button disabled="@(Busy||shared.Role=="viewer")" @onclick="SaveShared">Save shared revision</button><button class="secondary" disabled="@Busy" @onclick="ReloadShared">Reload shared film</button><a href="@("project/"+shared.Id)">Access, history &amp; publish</a>}else{<span>Personal draft</span>@if(Session.Current is null){<a href="@(string.IsNullOrEmpty(ProjectId)?"account":"account?project="+Uri.EscapeDataString(ProjectId))">Sign in to collaborate</a>}else{<button disabled="@Busy" @onclick="CreateShared">Save to shared work</button>}}<button class="secondary" disabled="@Busy" @onclick="CompareDirection">Compare changes</button></section>
@if(Comparison.Length>0){<div class="comparison"><strong>Changes</strong><ul>@foreach(var line in Comparison){<li>@line</li>}</ul></div>}
<div class="action-strip"><button disabled="@Busy" @onclick="Apply">Apply and save draft</button><button class="secondary" disabled="@(Busy || HistoryIndex <= 0)" @onclick="Undo">Undo</button><button class="secondary" disabled="@(Busy || HistoryIndex >= History.Count-1)" @onclick="Redo">Redo</button><details><summary>Open or start a film</summary><button class="secondary" disabled="@Busy" @onclick="Blank">New film</button><label class="file-button">Open film file<InputFile disabled="@Busy" OnChange="Import" accept="application/json,.json" /></label></details><details><summary>Download</summary><button class="secondary" disabled="@Busy" @onclick="JsonExport">Editable file</button><button class="secondary" disabled="@Busy" @onclick="HtmlExport">Playable film</button><button class="secondary" disabled="@Busy" @onclick="FrameExport">Preview image</button><button class="secondary" disabled="@(Busy || !Capabilities.Webm)" @onclick="VideoExport">@(Recording ? "Recording… keep this tab visible" : "Record video")</button></details></div>
<div class="studio-grid">
<aside class="shot-rail"><h2>Shots <small>@(FilmRules.Duration(Film)/1000)s</small></h2><ol>@for(var i=0;i<Film.Shots.Count;i++){var index=i;var shot=Film.Shots[i];<li><button class="shot @(index==ShotIndex?"selected":"")" disabled="@Busy" @onclick="()=>SelectShot(index)"><b>@(index+1). @shot.Label</b><span>@shot.Stage · @(shot.DurationMs/1000.0)s</span></button></li>}</ol><div class="mini-actions"><button disabled="@(Busy||Film.Shots.Count>=12)" @onclick="DuplicateShot">Duplicate</button><button disabled="@(Busy||ShotIndex==0)" @onclick="()=>MoveShot(-1)">↑</button><button disabled="@(Busy||ShotIndex==Film.Shots.Count-1)" @onclick="()=>MoveShot(1)">↓</button><button class="danger" disabled="@(Busy||Film.Shots.Count==1)" @onclick="RemoveShot">Remove</button></div><p class="hint">Up to 90 seconds per film.</p></aside>
<section class="stage-area"><div class="stage-top"><strong>@CurrentShot.Label</strong><span>@((TimeMs/1000.0).ToString("0.0")) / @(FilmRules.Duration(Film)/1000.0)s</span></div><canvas id="stage-canvas" aria-label="Animated vector stage. Use the direction controls or drag the yellow start/end handle." tabindex="0"></canvas><div class="transport"><button disabled="@Busy" @onclick="Play">▶ Play film</button><button class="secondary" disabled="@Busy" @onclick="Pause">Pause</button><button class="secondary" disabled="@Busy" @onclick="()=>SelectShot(ShotIndex)">This shot</button><label>Film time<input type="range" disabled="@Busy" min="0" max="@FilmRules.Duration(Film)" step="50" value="@TimeMs" @oninput="Scrub" /></label></div><p class="hint">No audio. @(!Capabilities.Webm ? "Video recording is unavailable; download the playable film instead." : "Keep this tab visible while recording video.")</p><div class="direction-choice"><label>Handle <select disabled="@Busy" @bind="Endpoint" @bind:after="Refresh"><option value="start">Start position</option><option value="end">End position</option></select></label><span>Drag the yellow marker, or enter a position in Direction.</span></div></section>
<aside class="direction-panel"><h2>Direction</h2><label>Shot label<input disabled="@Busy" maxlength="80" @bind="CurrentShot.Label" /></label><div class="two"><label>Stage<select disabled="@Busy" @bind="CurrentShot.Stage">@foreach(var x in FilmRules.Stages){<option>@x</option>}</select></label><label>Duration, ms<input disabled="@Busy" type="number" min="3000" max="15000" step="100" @bind="CurrentShot.DurationMs" /></label></div><button class="secondary" disabled="@Busy" @onclick="FitSpeech">Fit captions to duration</button><label>Performer<select disabled="@Busy" @bind="SelectedActor" @bind:after="Refresh">@foreach(var p in CurrentShot.Performers){<option value="@p.ActorId">@CastName(p.ActorId)</option>}</select></label>
@if(SelectedPerformance is {} performer){<div class="two"><label>Gesture<select disabled="@Busy" @bind="performer.Pose">@foreach(var x in FilmRules.Poses){<option>@x</option>}</select></label><label>Expression<select disabled="@Busy" @bind="performer.Mood">@foreach(var x in FilmRules.Moods){<option>@x</option>}</select></label></div><div class="two"><label>Start X<input disabled="@Busy" type="number" min=".06" max=".94" step=".01" @bind="performer.FromX" /></label><label>End X<input disabled="@Busy" type="number" min=".06" max=".94" step=".01" @bind="performer.ToX" /></label><label>Start Y<input disabled="@Busy" type="number" min=".45" max=".92" step=".01" @bind="performer.FromY" /></label><label>End Y<input disabled="@Busy" type="number" min=".45" max=".92" step=".01" @bind="performer.ToY" /></label><label>Scale<input disabled="@Busy" type="number" min=".6" max="1.5" step=".1" @bind="performer.Scale" /></label><label class="check"><input disabled="@Busy" type="checkbox" @bind="performer.Flip" />Face left</label></div><button class="secondary danger" disabled="@(Busy||CurrentShot.Performers.Count==1)" @onclick="RemovePerformer">Remove from this shot</button>}
@if(CurrentShot.Performers.Count<4){<label>Add cast to this shot<select disabled="@Busy" @onchange="AddPerformer"><option value="">Choose performer</option>@foreach(var c in Film.Cast.Where(c=>CurrentShot.Performers.All(p=>p.ActorId!=c.Id))){<option value="@c.Id">@c.Name</option>}</select></label>}
<p class="hint">Choose Apply to preview and save your changes.</p></aside>
</div>
<section class="script-desk"><div><h2>Timed dialogue</h2><p>Captions belong to an on-stage performer. At least 0.7 seconds per beat.</p></div><div class="beats">@foreach(var line in CurrentShot.Speech){<div class="beat" @key="line.Id"><label>Speaker<select disabled="@Busy" @bind="line.ActorId">@foreach(var p in CurrentShot.Performers){<option value="@p.ActorId">@CastName(p.ActorId)</option>}</select></label><label>From, ms<input disabled="@Busy" type="number" min="0" step="100" @bind="line.StartMs" /></label><label>To, ms<input disabled="@Busy" type="number" min="700" step="100" @bind="line.EndMs" /></label><label class="line-text">Caption<textarea disabled="@Busy" maxlength="180" rows="2" @bind="line.Text"></textarea></label><button class="danger secondary" disabled="@Busy" @onclick="()=>RemoveLine(line)">Remove</button></div>}</div><button class="secondary" disabled="@(Busy||CurrentShot.Speech.Count>=8)" @onclick="AddLine">Add caption beat</button></section>
<section class="film-settings"><div><h2>The film</h2><label>Title<input disabled="@Busy" maxlength="120" @bind="Film.Title" /></label><label>Synopsis<textarea disabled="@Busy" maxlength="600" @bind="Film.Summary"></textarea></label></div><div><h2>Cast</h2>@foreach(var c in Film.Cast){<div class="cast-line"><label>Name<input disabled="@Busy" maxlength="32" @bind="c.Name" /></label><label>Shape<select disabled="@Busy" @bind="c.Look">@foreach(var x in FilmRules.Looks){<option>@x</option>}</select></label><label>Color<select disabled="@Busy" @bind="c.Color">@foreach(var x in FilmRules.Colors){<option>@x</option>}</select></label></div>}<button class="secondary" disabled="@(Busy||Film.Cast.Count>=6)" @onclick="AddCast">Add performer</button></div></section>

@code {
    Film[] Examples = Starters.All();
    Film Film = Starters.All()[0];
    int ShotIndex, HistoryIndex, TimeMs;
    string SelectedActor = "a", Endpoint = "start";
    List<string> History = [];
    IJSObjectReference? Module;
    DotNetObjectReference<Studio>? Reference;
    RecorderCapabilities Capabilities = new();
    bool Recording;
    [SupplyParameterFromQuery(Name="project")] public string? ProjectId{get;set;}
    [SupplyParameterFromQuery(Name="revision")] public int? HistoricalRevision{get;set;}
    [SupplyParameterFromQuery(Name="starter")] public int? StarterIndex{get;set;}
    ProjectInfo? SharedProject;
    int SharedRevision;
    Film? OpenedFilm;
    string[] Comparison=[]; Func<Task>? PendingReplacement; string ReplacementLabel=""; Task RequestReplacement(string label,Func<Task> action){ReplacementLabel=label;PendingReplacement=action;return Task.CompletedTask;} Task CancelReplacement(){PendingReplacement=null;return Task.CompletedTask;} async Task ConfirmReplacement(){var action=PendingReplacement;PendingReplacement=null;if(action is not null)await action();}
    long RouteGeneration;
    string SaveRequest=Guid.NewGuid().ToString(),SaveSignature="",CreateRequest=Guid.NewGuid().ToString(),CreateSignature="";
    Shot CurrentShot => Film.Shots[Math.Clamp(ShotIndex,0,Film.Shots.Count-1)];
    Performance? SelectedPerformance => CurrentShot.Performers.FirstOrDefault(x=>x.ActorId==SelectedActor);
    string CastName(string id) => Film.Cast.FirstOrDefault(x=>x.Id==id)?.Name ?? "Missing performer";
    int ShotStart => Film.Shots.Take(ShotIndex).Sum(x=>x.DurationMs);

    protected override async Task OnParametersSetAsync(){RouteGeneration++;if(Module is not null)await Act("open selected production",LoadRoute,replace:true);}

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if(!first)return;
        await Act("open studio",async()=>{
            Module=await JS.InvokeAsync<IJSObjectReference>("import","./stage.js"); Reference=DotNetObjectReference.Create(this);
            string? saved=null;try{saved=await Module.InvokeAsync<string?>("loadLocal");}catch(JSException){Message="Saving on this device is unavailable. Download the editable file to keep your film.";}
            if(saved is not null){try{Film=FilmRules.Parse(saved);Message="Draft restored.";}catch(Exception e) when(e is FormatException or JsonException){Message="Your draft could not be opened. A starter is shown; the saved draft is unchanged.";IsError=true;}}
            SelectValidActor();History=[FilmRules.Serialize(Film)];Capabilities=await Module.InvokeAsync<RecorderCapabilities>("mount","stage-canvas",Reference,Film);OpenedFilm=FilmRules.Clone(Film);await Refresh();await LoadRoute();
        });StateHasChanged();
    }
    async Task LoadRoute(){var epoch=RouteGeneration;var selected=ProjectId;SharedProject=null;Comparison=[];await Session.Load();if(epoch!=RouteGeneration)return;if(string.IsNullOrEmpty(selected)){if(StarterIndex is {} starter){if(starter<0||starter>=Examples.Length)throw new FormatException("That starter is unavailable.");Film=FilmRules.Clone(Examples[starter]);ShotIndex=TimeMs=HistoryIndex=0;History=[FilmRules.Serialize(Film)];await Refresh();}OpenedFilm=FilmRules.Clone(Film);return;}if(Session.Current is null)throw new FormatException("Sign in with an invited account before opening a shared film. Your local scene remains available.");var accountGeneration=Session.Generation;var response=await Api.Get<ProjectReply>("projects/"+Uri.EscapeDataString(selected));var candidate=response.Project.Film;FilmRules.Validate(candidate);if(HistoricalRevision is {} revision){if(response.Project.Role=="viewer")throw new FormatException("Viewers cannot inspect historical revisions.");candidate=(await Api.Get<VersionReply>("projects/"+Uri.EscapeDataString(selected)+"/history/"+revision)).Version.Film;FilmRules.Validate(candidate);}if(epoch!=RouteGeneration||selected!=ProjectId||accountGeneration!=Session.Generation)return;SharedProject=response.Project;SharedRevision=response.Project.Revision;Film=FilmRules.Clone(candidate);OpenedFilm=FilmRules.Clone(response.Project.Film);ShotIndex=TimeMs=HistoryIndex=0;History=[FilmRules.Serialize(Film)];SaveRequest=Guid.NewGuid().ToString();SaveSignature="";await Refresh();Message=HistoricalRevision is null?"Shared film opened. Choose Save shared revision to update it.":"Earlier revision opened. Saving creates a new revision.";}
    Task ReloadShared()=>RequestReplacement("Reload the shared film",DoReloadShared); Task DoReloadShared()=>Act("reload shared film",async()=>{await LoadRoute();Message+="";});
    Task CreateShared()=>Act("create shared film",async()=>{var json=FilmRules.Serialize(Film);if(CreateSignature!=json){CreateSignature=json;CreateRequest=Guid.NewGuid().ToString();}var generation=Session.Generation;var response=await Api.Post<ProjectReply>("projects",new{requestId=CreateRequest,film=Film});if(generation!=Session.Generation)return;Navigation.NavigateTo("studio?project="+response.Project.Id);});
    Task SaveShared()=>Act("save shared film",async()=>{if(SharedProject is null)throw new FormatException("Open a shared project first.");var selected=SharedProject.Id;var revision=SharedRevision;var generation=Session.Generation;var signature=selected+revision+FilmRules.Serialize(Film);if(SaveSignature!=signature){SaveSignature=signature;SaveRequest=Guid.NewGuid().ToString();}var response=await Api.Post<ProjectReply>("projects/"+selected,new{revision,requestId=SaveRequest,film=Film});if(selected!=ProjectId||generation!=Session.Generation)return;SharedRevision=response.SavedRevision??response.Project.Revision;SharedProject=response.Project;OpenedFilm=FilmRules.Clone(Film);Message=response.Project.Revision==SharedRevision?"Saved shared revision "+SharedRevision+". Publish only from the production page.":"Your film was saved as revision "+SharedRevision+", but a newer shared revision already exists. Export your JSON and reload before further shared changes.";});
    Task CompareDirection()=>Act("compare direction",()=>{FilmRules.Validate(Film);Comparison=OpenedFilm is null?[]:FilmRules.Compare(OpenedFilm,Film);if(Comparison.Length==0)Message="No scene changes from the opened film.";return Task.CompletedTask;});
    void SelectValidActor(){if(CurrentShot.Performers.All(x=>x.ActorId!=SelectedActor))SelectedActor=CurrentShot.Performers[0].ActorId;}
    async Task Refresh(){FilmRules.Validate(Film);if(Module is not null){SelectValidActor();await Module.InvokeVoidAsync("update",Film,TimeMs,SelectedActor,Endpoint);}}
    Task Blank()=>RequestReplacement("Start a new film",DoBlank); Task DoBlank()=>Act("new blank scene",async()=>{Film=new(){Title="A scene of my own",Cast=[new(){Id="a",Name="Performer",Look="dot",Color="orange"}],Shots=[new(){Id="shot1",Label="The first beat",DurationMs=6000,Stage="rooftop",Performers=[new(){ActorId="a",FromX=.2,ToX=.65,Pose="walk"}],Speech=[new(){Id="line1",ActorId="a",StartMs=500,EndMs=5500,Text="Every story starts by arriving somewhere."}]}]};ShotIndex=TimeMs=HistoryIndex=0;History=[FilmRules.Serialize(Film)];OpenedFilm=FilmRules.Clone(Film);Comparison=[];await Refresh();Message="New film opened.";});
    Task Apply()=>Act("apply scene",async()=>{FilmRules.Validate(Film);var json=FilmRules.Serialize(Film);if(History.Count==0||History[HistoryIndex]!=json){History=History.Take(HistoryIndex+1).ToList();History.Add(json);if(History.Count>30)History.RemoveAt(0);HistoryIndex=History.Count-1;}TimeMs=ShotStart;await Refresh();try{await Module!.InvokeVoidAsync("saveLocal",Film);Message="Draft saved.";}catch(JSException){Message="Preview updated. Saving is unavailable; download the editable file to keep your film.";IsError=true;}});
    Task SelectShot(int index)=>Act("select shot",async()=>{FilmRules.Validate(Film);ShotIndex=index;TimeMs=ShotStart;SelectValidActor();await Refresh();});
    Task Undo()=>Act("undo",async()=>{Film=FilmRules.Parse(History[--HistoryIndex]);ShotIndex=Math.Min(ShotIndex,Film.Shots.Count-1);TimeMs=ShotStart;await Refresh();await Module!.InvokeVoidAsync("saveLocal",Film);});
    Task Redo()=>Act("redo",async()=>{Film=FilmRules.Parse(History[++HistoryIndex]);ShotIndex=Math.Min(ShotIndex,Film.Shots.Count-1);TimeMs=ShotStart;await Refresh();await Module!.InvokeVoidAsync("saveLocal",Film);});
    Task LoadStarter(ChangeEventArgs e)=>RequestReplacement("Open another story",()=>DoLoadStarter(e)); Task DoLoadStarter(ChangeEventArgs e)=>Act("load original starter",async()=>{if(!int.TryParse(e.Value?.ToString(),out var n)||n<0||n>=Examples.Length)return;Film=FilmRules.Clone(Examples[n]);ShotIndex=TimeMs=0;SelectValidActor();History=[FilmRules.Serialize(Film)];HistoryIndex=0;await Refresh();Message="Starter opened.";});
    Task Import(InputFileChangeEventArgs e)=>Act("import film",async()=>{using var stream=e.File.OpenReadStream(FilmRules.MaxBytes);using var reader=new StreamReader(stream);var candidate=FilmRules.Parse(await reader.ReadToEndAsync());await QueueImportedFilm(candidate);}); async Task QueueImportedFilm(Film candidate){await RequestReplacement("Open this film file",()=>Act("open imported film",async()=>{Film=candidate;ShotIndex=TimeMs=0;SelectValidActor();History=[FilmRules.Serialize(Film)];HistoryIndex=0;await Refresh();Message="Film opened. Apply to save it on this device.";}));}
    Task JsonExport()=>Act("export JSON",async()=>{var json=FilmRules.Serialize(Film);await Module!.InvokeAsync<int>("downloadJson",json);Message="Editable file downloaded.";});
    Task HtmlExport()=>Act("export offline film",async()=>{FilmRules.Validate(Film);var credit="StageFold. Bundled performers and starter stories: CC0.";if(SharedProject?.Parent is {} parent)credit+=$" Adapted from {parent.Title} by {parent.AuthorAlias}, {Navigation.BaseUri}cut/{parent.Id}, {parent.License}.";await Module!.InvokeAsync<int>("downloadHtml",Film,credit);Message="Playable film downloaded.";});
    Task FrameExport()=>Act("export frame",async()=>{await Module!.InvokeAsync<int>("downloadFrame");Message="Preview image downloaded.";});
    Task VideoExport()=>Act("record film",async()=>{FilmRules.Validate(Film);Recording=true;StateHasChanged();try{var result=await Module!.InvokeAsync<RecordingResult>("recordWebm",Film);Message=$"Video downloaded ({result.Bytes:N0} bytes). No audio.";}finally{Recording=false;TimeMs=0;}});
    Task Play()=>Act("play",async()=>{FilmRules.Validate(Film);await Refresh();await Module!.InvokeVoidAsync("play");});
    Task Pause()=>Act("pause",async()=>await Module!.InvokeVoidAsync("pause"));
    async Task Scrub(ChangeEventArgs e){if(Busy||!int.TryParse(e.Value?.ToString(),out var time))return;TimeMs=time;FollowTime();await Module!.InvokeVoidAsync("seek",time);}
    Task DuplicateShot()=>Act("duplicate shot",async()=>{FilmRules.Validate(Film);var copy=FilmRules.Clone(Film).Shots[ShotIndex];copy.Id=FilmRules.NewId();copy.Label+=" — alternate";if(copy.Label.Length>80)copy.Label=copy.Label[..80];foreach(var line in copy.Speech)line.Id=FilmRules.NewId();if(FilmRules.Duration(Film)+copy.DurationMs>90000)throw new FormatException("The duplicate would exceed 90 seconds. Shorten or remove a shot first.");Film.Shots.Insert(ShotIndex+1,copy);ShotIndex++;TimeMs=ShotStart;await Refresh();});
    Task MoveShot(int delta)=>Act("reorder shot",async()=>{var index=ShotIndex+delta;if(index<0||index>=Film.Shots.Count)return;var shot=CurrentShot;Film.Shots.RemoveAt(ShotIndex);Film.Shots.Insert(index,shot);ShotIndex=index;TimeMs=ShotStart;await Refresh();});
    Task RemoveShot()=>Act("remove shot",async()=>{Film.Shots.RemoveAt(ShotIndex);ShotIndex=Math.Min(ShotIndex,Film.Shots.Count-1);TimeMs=ShotStart;await Refresh();});
    Task FitSpeech()=>Act("fit captions",async()=>{if(CurrentShot.DurationMs is <3000 or >15000)throw new FormatException("Set the shot duration between 3000 and 15000 ms first.");var lines=CurrentShot.Speech;if(lines.Count>0){var slot=CurrentShot.DurationMs/lines.Count;if(slot<700)throw new FormatException("There are too many caption beats for this shot's duration.");for(var i=0;i<lines.Count;i++){lines[i].StartMs=i*slot;lines[i].EndMs=(i+1)*slot;}}await Refresh();});
    Task AddPerformer(ChangeEventArgs e)=>Act("add performer",async()=>{var id=e.Value?.ToString();if(id is null||!Film.Cast.Any(x=>x.Id==id)||CurrentShot.Performers.Any(x=>x.ActorId==id))return;CurrentShot.Performers.Add(new(){ActorId=id,FromX=.5,ToX=.6});SelectedActor=id;await Refresh();});
    Task RemovePerformer()=>Act("remove performer",async()=>{CurrentShot.Speech.RemoveAll(x=>x.ActorId==SelectedActor);CurrentShot.Performers.RemoveAll(x=>x.ActorId==SelectedActor);SelectValidActor();await Refresh();});
    Task AddLine()=>Act("add caption",async()=>{var start=CurrentShot.Speech.Where(x=>x.ActorId==SelectedActor).Select(x=>x.EndMs).DefaultIfEmpty(0).Max();if(start+700>CurrentShot.DurationMs)throw new FormatException("No caption space remains for this performer. Shorten a beat or lengthen the shot.");CurrentShot.Speech.Add(new(){ActorId=SelectedActor,StartMs=start,EndMs=Math.Min(start+2000,CurrentShot.DurationMs)});await Refresh();});
    Task RemoveLine(Speech line)=>Act("remove caption",async()=>{CurrentShot.Speech.Remove(line);await Refresh();});
    Task AddCast()=>Act("add cast",async()=>{Film.Cast.Add(new(){Name="New performer",Look=FilmRules.Looks[Film.Cast.Count%FilmRules.Looks.Length],Color=FilmRules.Colors[Film.Cast.Count%FilmRules.Colors.Length]});await Refresh();});
    void FollowTime(){var offset=0;for(var i=0;i<Film.Shots.Count;i++){if(TimeMs<offset+Film.Shots[i].DurationMs||i==Film.Shots.Count-1){ShotIndex=i;SelectValidActor();return;}offset+=Film.Shots[i].DurationMs;}}
    [JSInvokable] public Task OnPlayback(int ms,bool playing){TimeMs=ms;FollowTime();StateHasChanged();return Task.CompletedTask;}
    [JSInvokable] public async Task OnActorMoved(string actorId,string endpoint,double x,double y){if(Busy)return;var p=CurrentShot.Performers.FirstOrDefault(p=>p.ActorId==actorId);if(p is null)return;if(endpoint=="end"){p.ToX=Math.Round(x,3);p.ToY=Math.Round(y,3);}else{p.FromX=Math.Round(x,3);p.FromY=Math.Round(y,3);}await Apply();StateHasChanged();}
    public async ValueTask DisposeAsync(){Reference?.Dispose();if(Module is not null){try{await Module.InvokeVoidAsync("dispose","stage-canvas");await Module.DisposeAsync();}catch(JSDisconnectedException){}}}
    sealed class RecorderCapabilities { public bool Webm {get;set;} public string Codec {get;set;}=""; }
    sealed class RecordingResult { public long Bytes {get;set;} public string Mime {get;set;}=""; }
}
