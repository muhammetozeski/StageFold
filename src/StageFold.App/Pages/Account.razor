@page "/account"
@inherits ActionPage
@inject StageApi Api
@inject AccountSession Session
@inject IJSRuntime JS
<PageTitle>Account — StageFold</PageTitle>
<div class="page narrow"><h1>Account</h1><p>Save shared films, invite collaborators and publish your work.</p><Status Text="@Message" Error="@IsError" />
@if(Key is not null){<section class="secret-box"><h2>Save this recovery key privately</h2><p>It is shown once. Anyone holding it can access this account. There is no email reset.</p><code>@Key</code><div class="actions"><button disabled="@Busy" @onclick="SaveKey">Download private key file</button><button class="secondary" disabled="@Busy" @onclick="()=>Key=null">I saved it — hide key</button></div></section>}
@if(Session.Current is {} a){<section><h2>@a.Alias</h2><p>@if(a.Premium){<span class="pill">Studio member</span>}</p><div class="actions"><a href="projects">Open shared work</a><button class="secondary" disabled="@Busy" @onclick="Logout">Sign out</button></div><details><summary>Delete this account</summary><p>This deletes owned shared projects, versions and membership access. Your published cuts are withdrawn and attributed to “Deleted author”; existing licensed remixes and other people's exported copies remain.</p><label>Type DELETE MY ACCOUNT<input disabled="@Busy" @bind="Confirmation" /></label><button class="danger" disabled="@(Busy||Confirmation!="DELETE MY ACCOUNT")" @onclick="Delete">Delete account and owned shared work</button></details></section>}
else {<section><h2>Create account</h2><label>Public display alias<input disabled="@Busy" maxlength="40" @bind="Alias" autocomplete="nickname" /></label><button disabled="@(Busy||string.IsNullOrWhiteSpace(Alias))" @onclick="Create">Create account</button></section><section><h2>Recover an existing account</h2><label>Private recovery key<input disabled="@Busy" type="password" maxlength="43" @bind="Recovery" autocomplete="off" /></label><button class="secondary" disabled="@(Busy||Recovery.Length!=43)" @onclick="Recover">Recover account</button></section>}
@if(Session.Current is not null&&Key is null&&ReturnPath is not null){<p><a class="button-link" href="@ReturnPath">Continue to your film</a></p>}
<section><h2>Accept a collaborator invitation</h2><p>Sign in, then paste your private invitation.</p><label>One-use invitation token<input disabled="@Busy" type="password" maxlength="43" @bind="Invitation" autocomplete="off" /></label><button disabled="@(Busy||Session.Current is null||Key is not null||Invitation.Length!=43)" @onclick="Join">Join shared project</button>@if(JoinedProject is not null){<p><a href="@("project/"+JoinedProject)">Open the joined project</a></p>}</section><button class="secondary" disabled="@Busy" @onclick="RefreshAccount">Refresh account</button></div>
@code {
 string Alias="",Recovery="",Invitation="",Confirmation="";string? Key,JoinedProject;
 [SupplyParameterFromQuery(Name="cut")]public string? ReturnCut{get;set;}
 [SupplyParameterFromQuery(Name="project")]public string? ReturnProject{get;set;}
 string? ReturnPath=>Guid.TryParse(ReturnCut,out var cut)?"cut/"+cut:Guid.TryParse(ReturnProject,out var project)?"studio?project="+project:null;
 Task RefreshAccount()=>Act("refresh account",async()=>{var result=await Api.Get<AccountReply>("account");Session.Accept(result.Account);});
 protected override async Task OnInitializedAsync(){await Act("read account",Session.Load);}
 Task Create()=>Act("create account",async()=>{var result=await Api.Post<AccountReply>("accounts",new{alias=Alias});Session.Accept(result.Account);Key=result.RecoveryKey;Recovery="";Message="Account created. Save your recovery key before leaving this page.";});
 Task Recover()=>Act("recover account",async()=>{var result=await Api.Post<AccountReply>("sessions",new{recoveryKey=Recovery});Session.Accept(result.Account);Recovery="";Key=null;Message="Signed in.";});
 Task Logout()=>Act("sign out",async()=>{await Api.Post<OkReply>("sessions/logout",new{});Session.Accept(null);Key=null;Message="Signed out. Local film drafts stay in this browser.";});
 Task Delete()=>Act("delete account",async()=>{await Api.Post<OkReply>("account/delete",new{confirmation=Confirmation});Session.Accept(null);Key=null;Confirmation="";Message="The account and owned private work were deleted; its public cuts were withdrawn.";});
 Task Join()=>Act("join project",async()=>{var response=await Api.Post<JoinReply>("invites/join",new{token=Invitation});JoinedProject=response.ProjectId;Invitation="";Message="Joined as "+response.Role+".";});
 Task SaveKey()=>Act("download recovery key",async()=>{await JS.InvokeVoidAsync("StageFoldFiles.key",Key,Session.Current?.Alias);Message="Recovery key downloaded. Keep the file private.";});
}
