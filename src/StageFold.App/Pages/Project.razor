@page "/project/{Id}"
@inherits ActionPage
@inject StageApi Api
@inject AccountSession Session
<PageTitle>Shared production — StageFold</PageTitle>
<div class="page"><p class="eyebrow">THE CUTTING ROOM</p><h1>@(ProjectData?.Title??"Shared production")</h1><Status Text="@Message" Error="@IsError" />
@if(ProjectData is {} p){<p><span class="pill">@p.Role</span> Revision @p.Revision. Changes are saved only by explicit studio actions.</p><div class="actions"><a class="button-link" href="@("/studio?project="+Id)">Open this film in studio</a><button class="secondary" disabled="@Busy" @onclick="Refresh">Refresh production</button></div>@if(p.ParentCut is not null){<p>Remix source: <a href="@("/cut/"+p.ParentCut)">immutable public cut</a>. The source's license and attribution travel with publication.</p>}
<section><h2>People with actual access</h2><p>No one is added until they sign in and consume an invitation. Owners can remove access; private exports already downloaded cannot be recalled.</p><ul class="work-list">@foreach(var member in Members){<li><b>@member.Alias</b> · @member.Role @if(p.Role=="owner"&&member.Role!="owner"){<div class="actions"><button class="secondary" disabled="@Busy" @onclick='()=>Role(member,"editor")'>Editor</button><button class="secondary" disabled="@Busy" @onclick='()=>Role(member,"viewer")'>Viewer</button><button class="danger" disabled="@Busy" @onclick='()=>Role(member,"remove")'>Remove access</button></div>}</li>}</ul>
@if(p.Role=="owner"){<label>New collaborator role<select disabled="@Busy" @bind="InviteRole"><option value="editor">Editor — can change the shared film and inspect history</option><option value="viewer">Viewer — can read/export the current shared film</option></select></label><button disabled="@Busy" @onclick="Invite">Make one-use private invitation</button>@if(InviteToken is not null){<div class="secret-box"><p>Give this token privately to your collaborator. They paste it on the Account page. Valid until @DateTimeOffset.FromUnixTimeMilliseconds(InviteExpiry).ToString("u").</p><code>@InviteToken</code><button class="secondary" disabled="@Busy" @onclick="()=>InviteToken=null">Hide token</button></div>}<details><summary>Invitation status and revocation</summary>@foreach(var i in Invitations){<p>@i.Role · @(i.Used?"used":i.RevokedAt is not null?"revoked":"pending") · expires @DateTimeOffset.FromUnixTimeMilliseconds(i.ExpiresAt).ToString("u") @if(!i.Used&&i.RevokedAt is null){<button class="danger" disabled="@Busy" @onclick="()=>Revoke(i)">Revoke</button>}</p>}</details>}</section>
@if(p.Role!="viewer"){<section><h2>Saved revisions</h2><p>Restoration is an explicit new save in the studio. It never rewrites an old version.</p><ol>@foreach(var v in Versions){<li>Revision @v.Revision by @(v.AuthorAlias??"Deleted account") · @DateTimeOffset.FromUnixTimeMilliseconds(v.SavedAt).ToString("u") · <a href="@("/studio?project="+Id+"&revision="+v.Revision)">Load as editable historical copy</a></li>}</ol></section>}
@if(p.Role=="owner"){<section><h2>Publish this saved revision</h2><p>This creates an immutable public film under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a>: people may copy, adapt and use it commercially with attribution. Your alias, film and pinned remix source become public; membership and private history do not. Only publish work you can license. An export or licensed remix cannot be recalled by withdrawal.</p><label class="check"><input type="checkbox" disabled="@Busy" @bind="Reuse" />I permit public reuse under CC BY 4.0.</label><label class="check"><input type="checkbox" disabled="@Busy" @bind="Rights" />I have the rights and any collaborator permission needed to publish this film.</label><button disabled="@(Busy||!Reuse||!Rights)" @onclick="Publish">Publish saved revision @p.Revision</button>@if(PublishedId is not null){<p><a href="@("/cut/"+PublishedId)">Open the actual public cut</a></p>}</section><section><details><summary>Delete private shared production</summary><p>This deletes its private revisions and access. Published cuts are separate licensed snapshots and remain until explicitly withdrawn.</p><label>Type DELETE SHARED PROJECT<input disabled="@Busy" @bind="DeleteText" /></label><button class="danger" disabled="@(Busy||DeleteText!="DELETE SHARED PROJECT")" @onclick="Delete">Delete shared project</button></details></section>}}
else if(!Busy){<p><a href="/account">Sign in</a> with an invited account, or open <a href="/projects">your shared work</a>.</p>}</div>
@code {
 [Parameter]public string Id{get;set;}="";ProjectInfo? ProjectData;MemberInfo[] Members=[];HistoryInfo[] Versions=[];InviteInfo[] Invitations=[];string InviteRole="editor",DeleteText="";string? InviteToken,PublishedId;long InviteExpiry;bool Reuse,Rights;string PublishRequest=Guid.NewGuid().ToString();long LoadGeneration;
 protected override async Task OnParametersSetAsync(){var epoch=++LoadGeneration;ProjectData=null;Members=[];Versions=[];Invitations=[];InviteToken=null;PublishedId=null;Reuse=Rights=false;await Act("load production",()=>Load(epoch),replace:true);}
 async Task Load(long epoch){var selected=Id;await Session.Load();if(Session.Current is null)return;var generation=Session.Generation;var project=await Api.Get<ProjectReply>("projects/"+selected);var members=await Api.Get<MembersReply>("projects/"+selected+"/members");var history=project.Project.Role=="viewer"?new HistoryReply():await Api.Get<HistoryReply>("projects/"+selected+"/history");var invites=project.Project.Role=="owner"?await Api.Get<InvitesReply>("projects/"+selected+"/invites"):new InvitesReply();if(epoch!=LoadGeneration||selected!=Id||generation!=Session.Generation)return;ProjectData=project.Project;Members=members.Members;Versions=history.Versions;Invitations=invites.Invites;}
 Task Refresh()=>Act("refresh production",()=>Load(++LoadGeneration));
 Task Invite()=>Act("make invitation",async()=>{var response=await Api.Post<InviteReply>("projects/"+Id+"/invites",new{role=InviteRole});InviteToken=response.Token;InviteExpiry=response.ExpiresAt;await Load(++LoadGeneration);Message="One-use invitation created. Share it privately.";});
 Task Revoke(InviteInfo i)=>Act("revoke invitation",async()=>{await Api.Post<OkReply>("projects/"+Id+"/invites/"+i.Id+"/revoke",new{});InviteToken=null;await Load(++LoadGeneration);Message="Invitation revoked.";});
 Task Role(MemberInfo m,string role)=>Act("change collaborator role",async()=>{await Api.Post<OkReply>("projects/"+Id+"/members/"+m.Id,new{role});await Load(++LoadGeneration);Message="Project access updated on the server.";});
 Task Publish()=>Act("publish cut",async()=>{var result=await Api.Post<CutReply>("cuts",new{projectId=Id,revision=ProjectData!.Revision,requestId=PublishRequest,allowRemix=Reuse,rightsConfirmed=Rights});PublishedId=result.Cut.Id;PublishRequest=Guid.NewGuid().ToString();Message="An actual immutable public cut is available at the link below.";});
 Task Delete()=>Act("delete production",async()=>{await Api.Post<OkReply>("projects/"+Id+"/delete",new{confirmation=DeleteText});ProjectData=null;Message="The shared project and private history were deleted.";});
}
