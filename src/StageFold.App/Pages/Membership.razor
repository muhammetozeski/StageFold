@page "/membership"
@inherits ActionPage
@inject StageApi Api
@inject AccountSession Session
@inject NavigationManager Navigation
<PageTitle>Membership — StageFold</PageTitle>
<div class="page narrow"><p class="eyebrow">KEEP THE LOCAL STUDIO OPEN</p><h1>More room for a production.</h1><p>The full local editor, original starters, JSON, PNG, offline film and supported WebM exports are free. A free account owns up to three shared projects with four members each, including the owner.</p><Status Text="@Message" Error="@IsError" />
@if(Billing is {} b){<section><h2>Studio collaboration</h2><p>Proposed price: $9 USD per month for 30 owned shared projects and 12 members per project. Existing saved work remains readable when a membership ends. Price and willingness to pay are unvalidated.</p><p>Provider mode: <b>@b.Mode</b> · Checkout configured: <b>@b.Configured</b> · Live membership active: <b>@b.Premium</b>.</p>@if(!b.Configured){<p class="status">Checkout is unavailable. The operator has not configured the merchant key, fixed price and signed notification secret together. The free service works now.</p>}else if(b.Premium){<button disabled="@Busy" @onclick="Manage">Manage active subscription</button>}else if(Session.Current is null){<p><a href="/account">Sign in</a> before checkout.</p>}else{<button disabled="@Busy" @onclick="Checkout">Open @(b.Mode=="test"?"test":"provider") checkout — $9/month</button>}<button class="secondary" disabled="@Busy" @onclick="Refresh">Refresh verified membership state</button><p class="hint">Returning from checkout is not proof of payment. Only a verified live subscription notification enables paid allowances. Test notifications never enable live membership. An existing pending checkout is reused; an active subscriber uses management.</p></section>}
</div>
@code {BillingReply? Billing;string RequestId=Guid.NewGuid().ToString();protected override async Task OnInitializedAsync(){await Act("read membership",Load);}async Task Load(){await Session.Load();var generation=Session.Generation;var reply=await Api.Get<BillingReply>("billing");if(generation!=Session.Generation)return;Billing=reply;}Task Refresh()=>Act("refresh membership",Load);Task Checkout()=>Act("open checkout",async()=>{var response=await Api.Post<CheckoutReply>("billing/checkout",new{requestId=RequestId});if(!response.Url.StartsWith("https://checkout.stripe.com/",StringComparison.Ordinal))throw new FormatException("The checkout destination was not accepted.");Navigation.NavigateTo(response.Url,forceLoad:true);});Task Manage()=>Act("manage membership",async()=>{var response=await Api.Post<CheckoutReply>("billing/portal",new{});if(!response.Url.StartsWith("https://billing.stripe.com/",StringComparison.Ordinal))throw new FormatException("The billing destination was not accepted.");Navigation.NavigateTo(response.Url,forceLoad:true);});
 sealed class BillingReply{public bool Configured{get;set;}public string Mode{get;set;}="";public bool Premium{get;set;}public JsonElement Plan{get;set;}public JsonElement Subscriptions{get;set;}public string PriceStatus{get;set;}="";}
 sealed class CheckoutReply{public string Url{get;set;}="";public string? Mode{get;set;}public string? Warning{get;set;}}
}
