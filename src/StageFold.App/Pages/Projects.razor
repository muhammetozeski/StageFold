@page "/projects"
@inherits ActionPage
@inject StageApi Api
@inject AccountSession Session
<PageTitle>Shared work — StageFold</PageTitle>
<div class="page"><p class="eyebrow">A PRODUCTION, NOT A FEED</p><h1>Shared work.</h1><p>One film, explicit roles, saved revisions. The owner chooses when a finished cut becomes public.</p><Status Text="@Message" Error="@IsError" />
@if(Session.Current is null){<p><a href="/account">Create or recover an account</a> to save shared films. <a href="/studio">The local studio</a> works immediately.</p>}
else{<p>@Session.Current.Alias · @Allowance.UsedProjects / @Allowance.ProjectLimit owned shared projects. Invitations to another person's projects do not use your owned allowance.</p><div class="actions"><a class="button-link" href="/studio">Create from the studio's local film</a><button class="secondary" disabled="@Busy" @onclick="Refresh">Refresh shared work</button></div><ul class="work-list">@foreach(var p in Items){<li><span class="pill">@p.Role</span><h2><a href="@("/project/"+p.Id)">@p.Title</a></h2><p>Revision @p.Revision · @DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedAt).ToString("u") @if(p.ParentCut is not null){<span>· A pinned remix</span>}</p><a href="@("/studio?project="+p.Id)">Open film in studio</a></li>}</ul>@if(Items.Length==0){<p>No shared projects in this account. Open an original starter in the studio, then choose Create shared film.</p>}}
</div>
@code {ProjectInfo[] Items=[];AccountAllowance Allowance=new();protected override async Task OnInitializedAsync(){await Act("read shared work",Load);}async Task Load(){await Session.Load();if(Session.Current is null)return;var generation=Session.Generation;var response=await Api.Get<ProjectsReply>("projects");if(generation!=Session.Generation)return;Items=response.Projects;Allowance=response.Account;}Task Refresh()=>Act("refresh shared work",Load);}
