@page "/projects"
@inherits ActionPage
@inject StageApi Api
@inject AccountSession Session
<PageTitle>Shared work — StageFold</PageTitle>
<div class="page"><h1>Shared films</h1><Status Text="@Message" Error="@IsError" />
@if(Session.Current is null){<p><a href="account">Create or recover an account</a> to save shared films. <a href="studio">The local studio</a> works immediately.</p>}
else{<p>@Session.Current.Alias · @Allowance.UsedProjects / @Allowance.ProjectLimit films owned</p><div class="actions"><a class="button-link" href="studio">Open studio</a><button class="secondary" disabled="@Busy" @onclick="Refresh">Refresh</button></div><ul class="work-list">@foreach(var p in Items){<li><span class="pill">@p.Role</span><h2><a href="@("project/"+p.Id)">@p.Title</a></h2><p>Revision @p.Revision · @DateTimeOffset.FromUnixTimeMilliseconds(p.UpdatedAt).ToString("u") @if(p.ParentCut is not null){<span>· Remix</span>}</p><a href="@("studio?project="+p.Id)">Open film in studio</a></li>}</ul>@if(Items.Length==0){<p>No shared films yet. Open the studio and choose Save to shared work.</p>}}
</div>
@code {ProjectInfo[] Items=[];AccountAllowance Allowance=new();protected override async Task OnInitializedAsync(){await Act("read shared work",Load);}async Task Load(){await Session.Load();if(Session.Current is null)return;var generation=Session.Generation;var response=await Api.Get<ProjectsReply>("projects");if(generation!=Session.Generation)return;Items=response.Projects;Allowance=response.Account;}Task Refresh()=>Act("refresh shared work",Load);}
